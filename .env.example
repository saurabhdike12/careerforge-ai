# =============================================================
# CareerForge AI — Environment Configuration
# Copy this file to .env and fill in your credentials
# =============================================================

# IBM watsonx.ai Credentials (REQUIRED)
WATSONX_API_KEY=your_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model Configuration
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2
GRANITE_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database
DATABASE_URL=sqlite:///./careerforge.db

# Vector Store
CHROMA_PERSIST_DIR=./backend/data/chroma_db

# Session Settings
SESSION_EXPIRY_HOURS=24
MAX_QUESTIONS_PER_SESSION=20

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=30
